$escape = static fn (string $value): string => htmlspecialchars($value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
$formatMilliseconds = static function (int $milliseconds): string {
		$seconds = max(0, (int)round($milliseconds / 1000));
		if ($seconds < 60) {
			return $seconds . 's';
		}
		$minutes = intdiv($seconds, 60);
		$seconds %= 60;
		return $minutes . 'm ' . $seconds . 's';
	};
$greaderHelp = $this->entries_read_available
	? _t('ext.interaction_analytics.greader_ingestion_help')
	: _t('ext.interaction_analytics.greader_ingestion_unavailable');
$modelStatus = $this->interest_model_status;
$modelMetrics = is_array($modelStatus['metrics'] ?? null) ? $modelStatus['metrics'] : [];
$formatTimestamp = static function (mixed $milliseconds): string {
	return is_numeric($milliseconds) && (int)$milliseconds > 0
		? gmdate('Y-m-d H:i:s \U\T\C', intdiv((int)$milliseconds, 1000))
		: '—';
};
$formatPercent = static function (mixed $value): string {
	return is_numeric($value) ? number_format((float)$value * 100, 1) . '%' : '—';
};
$statusLabels = [
	'schema_unavailable' => _t('ext.interaction_analytics.model_status_schema_unavailable'),
	'running' => _t('ext.interaction_analytics.model_status_running'),
	'requested' => _t('ext.interaction_analytics.model_status_requested'),
	'trained' => _t('ext.interaction_analytics.model_status_trained'),
	'insufficient_data' => _t('ext.interaction_analytics.model_status_insufficient'),
	'failed' => _t('ext.interaction_analytics.model_status_failed'),
	'untrained' => _t('ext.interaction_analytics.model_status_untrained'),
];
